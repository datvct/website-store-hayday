# Copy this file to .env before deploying and replace every sensitive value.
APP_PORT=8088
API_PORT=8080
DB_PORT=5433
POSTGRES_PASSWORD=admin123
JWT_SECRET=change-a-long-random-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SHOP_NAME=Hay Day Order

# VietQR/bank configuration. Leave empty to hide the QR until configured.
BANK_CODE=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
MOMO_PHONE=
MOMO_ACCOUNT_NAME=

FRONTEND_ORIGIN=http://localhost:8088

# S3-compatible image storage (MinIO locally, AWS S3 in production).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=hayday_minio
S3_SECRET_KEY=hayday_minio_password
S3_BUCKET=hayday-images
IMAGE_STORAGE_BASE_URL=http://minio:9000/hayday-images
